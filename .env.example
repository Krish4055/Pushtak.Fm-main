# GNANI_API_KEY: Required for Gnani AI models (Timbre v2.5 TTS, Prisma v2.5 STT, Evon v3.3 LLM)
GNANI_API_KEY="MY_GNANI_API_KEY"

# Optional Gnani endpoint overrides (defaults preconfigured in server/config/gnani.ts)
GNANI_TTS_ENDPOINT="https://api.gnani.ai/v2/tts"
GNANI_STT_ENDPOINT="https://api.gnani.ai/v2/stt"
GNANI_LLM_ENDPOINT="https://api.gnani.ai/v3/evon"

# GEMINI_API_KEY: Fallback for Q&A, RAG embeddings, and backup speech synthesis
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

